# ============================================================
# NEURIX POS — Variables de entorno
# Copiar este archivo a .env y ajustar los valores
# NUNCA commitear .env al repositorio
# ============================================================

# Entorno: development | production
APP_ENV=development

# Base de datos
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=neurixbd

# QZ Tray — firma de peticiones de impresión (ver README-QZ-TRAY.md)
# Solo si se usan rutas distintas a files/certificados/qz/
#QZ_CERT_PATH=
#QZ_KEY_PATH=
#QZ_KEY_PASS=
