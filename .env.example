# ============================================================
# NEURIX POS — Variables de entorno
# Copiar este archivo a .env y ajustar los valores
# NUNCA commitear .env al repositorio
# ============================================================

# Entorno: development | production
APP_ENV=development

# Base de datos
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=neurixbd

# QZ Tray — firma de peticiones de impresión (ver README-QZ-TRAY.md)
# Todas opcionales: el certificado se genera solo en files/certificados/qz/
# Nombre que la ventana de QZ Tray muestra como titular de la peticion
#QZ_CERT_CN=Neurix POS
#QZ_CERT_ORG=Neurix POS
# Otra carpeta o rutas para el par certificado/llave
#QZ_CERT_DIR=
#QZ_CERT_PATH=
#QZ_KEY_PATH=
#QZ_KEY_PASS=
# Windows: ruta a openssl.cnf si PHP no la encuentra sola
#QZ_OPENSSL_CONF=
