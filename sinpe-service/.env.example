# ── Configuración del servicio SINPE ──────────────────────────────────────────
# Copiá este archivo a `.env` y completá los valores. `.env` NUNCA se sube al
# repositorio (ya está cubierto por el .gitignore del proyecto).

# Puerto de escucha. Corre SOLO en localhost, nunca debe quedar expuesto a
# internet directamente (ver README.md → Seguridad).
PORT=3001
NODE_ENV=production

# ── Base de datos (la MISMA que usa el Facturador, ver app/config/database.php) ─
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=neurixbd
DB_PREFIX=tec_

# ── Credenciales OAuth de Google ─────────────────────────────────────────────
# El cliente OAuth del proveedor viene embebido en config.js; normalmente NO hace
# falta tocar nada de esto. Solo definí estas variables si vas a usar un cliente
# de Google propio.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Debe coincidir EXACTO con lo registrado como "Authorized redirect URI".
# Por defecto: http://127.0.0.1:<PORT>/oauth2/callback
# En producción tras un dominio HTTPS:
#   GOOGLE_REDIRECT_URI=https://tu-dominio.com/sinpe-oauth/callback  (ver nginx/proxy en README)
# GOOGLE_REDIRECT_URI=http://127.0.0.1:3001/oauth2/callback

# A dónde vuelve el navegador del administrador después de conectar/rechazar Gmail.
# (ajustar al host/puerto real donde sirvas el Facturador; en este proyecto en
# desarrollo local es http://localhost:85/shacienda/settings — ver conf.env)
RETURN_URL=http://localhost/settings

# Clave para cifrar el refresh_token en la base (32 bytes en base64). Generarla
# UNA vez y no perderla (si se pierde, hay que reconectar Gmail):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SINPE_TOKEN_KEY=

# (Opcional) Orígenes permitidos por CORS, separados por coma. Normalmente vacío:
# este servicio solo recibe llamadas de servidor a servidor desde el Facturador.
CORS_ORIGINS=

# (Opcional) Consulta usada para filtrar los correos SINPE en Gmail.
# GMAIL_QUERY=SINPE OR "sinpe movil" OR "transferencia sinpe" OR "ha recibido" OR colones
